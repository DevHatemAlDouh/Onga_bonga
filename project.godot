; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Onga Bonga"
run/main_scene="uid://cp4bi3t5c8s5q"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

NetworkHandler="*res://Components/Scripts/network_handler.gd"
TileRunInstancesGlobal="*res://addons/tile-run-instances/tile_run_instances_global.gd"
GameManager="*uid://dhuiumecmh8cy"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/tile-run-instances/plugin.cfg", "res://addons/tube/plugin.cfg")

[file_customization]

folder_colors={
"res://Components/Scenes/": "blue",
"res://Components/Scripts/": "yellow",
"res://Components/UI/": "red",
"res://Items/Scenes/": "blue",
"res://Items/Scripts/": "yellow",
"res://Items/UI/": "red",
"res://Projectile/Scenes/": "blue",
"res://Projectile/Scripts/": "yellow",
"res://Projectile/UI/": "red",
"res://World/Scenes/": "blue",
"res://World/Scripts/": "yellow"
}

[global_group]

Player=""
Enemy=""
Player_projectiles=""

